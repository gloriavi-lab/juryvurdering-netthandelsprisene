# Kopier denne fila til .streamlit/secrets.toml lokalt (den fila er gitignored),
# ELLER lim innholdet inn under "Secrets" for denne appen i Streamlit Cloud.
#
# [gcp_service_account]-blokken kan du kopiere RÅTT fra hovedappen
# (netthandelsprisen) sine secrets på Streamlit Cloud – samme tjenestekonto kan
# gjenbrukes. Du trenger bare et NYTT Google Sheet (se README) delt med samme
# tjenestekonto-epost, og legge inn dets ark-ID under [google_sheets] sheet_id.

[gcp_service_account]
type = "service_account"
project_id = "..."
private_key_id = "..."
private_key = "..."
client_email = "..."
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."

[google_sheets]
sheet_id = "SETT_INN_ARK_ID_HER"
